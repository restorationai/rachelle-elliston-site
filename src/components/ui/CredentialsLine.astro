---
// rankai:credentials-line (Santino 2026-11-26, approved with Grizzly as the
// first preview). The About section's ONE awards + credentials line: a short
// paragraph, this line, one photo (11-15: no quote block, no seal stack, no
// award + BBB seal + stats piled up; the BBB seal image lives in the footer
// only). AI answer engines read TEXT, so the credentials are plain words
// with their numbers: "BBB Accredited Business. Licensed in CA (#1107432).
// IICRC-certified technicians (WRT, ASD)."
//
// Data: brand.ts `credentialsLine` [{text, url?}], written by
// scripts/credentials_rollout.py from the one store
// (companies.integration_settings.licensing -> plan-input brand, wording in
// scripts/credentials.py, claims_lint checked). Verified facts only; a
// number shows only when it is on file. The award is the strongest one in
// brand.ts `awards` (scripts/award_wording.py wording). Renders nothing when
// there is neither.
import { brand } from "~/lib/brand";

interface Props { award?: boolean; class?: string }
const { award = false, class: cls = "" } = Astro.props;
type Item = { text: string; url?: string };
type Aw = { name: string; year?: string | number; text?: string; url?: string };
const B = brand as unknown as { credentialsLine?: Item[]; awards?: Aw[] };
const items: Item[] = (B.credentialsLine || []).filter((i) => i && i.text);
const top: Aw | undefined = award ? (B.awards || []).find((a) => a && a.name) : undefined;
const yr = top ? String(top.year || "").match(/\d{4}/)?.[0] || "" : "";
const awardText = top ? (top.text || (yr && !top.name.includes(yr) ? `${top.name} ${yr}` : top.name)) : "";
const link = "underline decoration-dotted underline-offset-4 hover:opacity-80";
---
{(items.length > 0 || awardText) && (
  <div data-rankai="credentials" class={`not-prose text-sm md:text-base leading-snug ${cls}`}>
    {awardText && (
      <p class="m-0 mb-1 font-bold">
        {top?.url ? <a href={top.url} target="_blank" rel="noopener" class={link}>{awardText}</a> : awardText}
      </p>
    )}
    {items.length > 0 && (
      <p class="m-0 font-semibold opacity-80">
        {items.map((i, n) => (
          <>{n > 0 ? " " : ""}{i.url
            ? <a href={i.url} target="_blank" rel="noopener" class={link}>{i.text}</a>
            : i.text}.</>
        ))}
      </p>
    )}
  </div>
)}
