---
// 2026-10-04 (Santino, Dry1 review): stat tiles REMOVED from the template
// and every site; headline capped at two lines (short name when the full
// name is long, else "us"). Applied by scripts/home_proof_slim.py.
// HomeProof: "Why {City} homeowners choose {Brand}" (Santino 2026-10-03).
//
// The homepage does NOT carry a "The Best Restoration Company in {City}"
// headline (an unverifiable self-superlative). It earns "best" with proof:
// the real Google rating + review count, licenses and certifications on file,
// the founding year on file, 24/7 / response time only when the brand truth
// allows it, and a few real review excerpts. Every piece is data-driven and
// simply omitted when the data is missing; the whole section renders nothing
// when there is no proof at all.
//
// "top-rated {trade} company in {City}" appears ONLY when the synced Google
// rating is >= 4.5 across >= 20 reviews (TOP_RATED_* below).
//
// Data: brand.ts only. gbpRatingValue / gbpReviewCount / gbpReviews are
// synced from the live GBP by scripts/sync_brand_reviews.py (real ratings
// only). licenseNumbers / certifications / foundedYear / hours mirror
// plan-input brand truth; responseMinutes mirrors plan-input
// brand.response_minutes (the claims_lint gate) and is absent on older sites.
// The 24/7 test is the same regex as TrustStrip / Header / claims_lint.
//
// LIGHT-THEME VARIANT (astro-starter-light overlay): same logic as the
// starter file, light surfaces only. Keep the two in sync.
// On the homepage this replaces ReviewsStrip (same rating + snippets job, plus
// the credentials), so review quotes are not stacked three times.
// AggregateRating schema is NOT emitted here: schema.ts already embeds it in
// the homepage LocalBusiness block when both GBP fields are present.
import { brand } from "~/lib/brand";
import { Star, Phone, Award } from "@lucide/astro";
import { awards, awardSeal } from "~/lib/awards";
import { getCollection } from "astro:content";

const TOP_RATED_MIN_RATING = 4.5;
const TOP_RATED_MIN_REVIEWS = 20;

const B = brand as unknown as Record<string, unknown>;
const str = (v: unknown) => String(v ?? "").trim();

const city = str(brand.primaryCity);
// MARKET NAME (Santino 2026-10-12): headings speak to the metro ("Las Vegas
// homeowners"), not one office's suburb ("North Las Vegas"), which also holds
// up once a client runs several Google profiles. brand.marketCity overrides;
// otherwise a directional prefix is dropped when the bare city is also one of
// the site's service areas (North Las Vegas -> Las Vegas).
let areaSlugs: string[] = [];
try {
  areaSlugs = (await getCollection("serviceAreas" as never)).map((e: any) => String(e.slug || e.id).replace(/\.mdx?$/, ""));
} catch { areaSlugs = []; }
const stateAb = str(brand.primaryState).toLowerCase();
const bare = city.replace(/^(North|South|East|West|Northeast|Northwest|Southeast|Southwest)\s+/i, "");
const slugOf = (c: string) => `${c.toLowerCase().replace(/[^a-z0-9]+/g, "-")}-${stateAb}`;
const market = str(B.marketCity) || (bare !== city && areaSlugs.includes(slugOf(bare)) ? bare : city);
const name = str(brand.displayName);
const trade = str(B.tradeNoun) || "restoration";

const rating = str(brand.gbpRatingValue);
const count = str(brand.gbpReviewCount);
const ratingNum = parseFloat(rating);
const countNum = parseInt(count.replace(/[^0-9]/g, ""), 10);
const hasRating = ratingNum > 0 && countNum > 0;
const topRated = hasRating && ratingNum >= TOP_RATED_MIN_RATING && countNum >= TOP_RATED_MIN_REVIEWS;
// Always five stars under the subtext (Santino 2026-10-12: "never show 4
// stars"); the real rating and review count are stated in the lead text.
const stars = hasRating ? 5 : 0;
const reviewsUrl = brand.googleCid
  ? `https://www.google.com/maps?cid=${brand.googleCid}`
  : brand.placeId
    ? `https://search.google.com/local/reviews?placeid=${brand.placeId}`
    : "";

// Review excerpts: real synced reviews, 4+ stars, ones that mention the city
// first; trimmed to whole sentences (never mid-word) so the quote stays honest.
function excerpt(text: string, max = 170): string {
  const t = text.replace(/\s+/g, " ").replace(/[…]$|\.\.\.$/, "").trim();
  const sentences = t.match(/[^.!?]+[.!?]+/g) || [];
  let out = "";
  for (const s of sentences) {
    if ((out + s).length > max) break;
    out += s;
  }
  if (out.trim()) return out.trim();
  const cut = t.slice(0, max);
  return `${cut.slice(0, Math.max(cut.lastIndexOf(" "), 40)).trim()}…`;
}
const reviews = ((B.gbpReviews as { author: string; rating: number; text: string; when?: string }[]) || [])
  .filter((r) => r && r.text && (r.rating || 0) >= 4)
  .map((r, i) => ({ ...r, i, local: city && r.text.toLowerCase().includes(city.toLowerCase()) ? 0 : 1 }))
  .sort((a, b) => a.local - b.local || a.i - b.i)
  .slice(0, 3)
  .map((r) => ({ author: r.author, rating: r.rating, when: r.when, quote: excerpt(r.text) }));

const lead = topRated
  ? `${name} is a top-rated ${trade} company in ${market}, with a ${rating}-star Google rating across ${count} reviews.`
  : hasRating && ratingNum >= 4
    ? `${market} homeowners rate ${name} ${rating} out of 5 stars across ${count} Google reviews.`
    : `Here is what ${name} brings to every ${trade} job in ${market}.`;

// AWARD (Santino 2026-10-12): the client's real award joins this section
// (its official badge image when we hold one, else a gold medallion), so the
// proof reads "rated X by homeowners + award winner" in one place. Same data
// as the trust strip, schema and llms.txt (brand.ts awards, ai_answers.py).
type Aw = { name: string; year?: string | number; category?: string; organizer?: string; url?: string; image?: string; display_only?: boolean };
const award = (((B.awards as Aw[]) || []).filter((a) => a && a.name && !a.display_only
  && !/businessrate/i.test(`${a.organizer || ""} ${a.name}`)))[0];
const awardYear = award ? String(award.year || (String(award.name).match(/20\d\d/) || [""])[0]) : "";
const awardLabel = award ? `${award.name}${awardYear && !String(award.name).includes(awardYear) ? ` ${awardYear}` : ""}` : "";
const leadFull = award ? `${lead} Winner of the ${awardLabel}.` : lead;

// Premium fallback when a real award has no official badge image: a gold
// laurel medallion with the award year (never the ribbon icon).
function medallion(year: string): string {
  const leaves = Array.from({ length: 7 }, (_, i) => {
    const a = (200 + i * 18) * Math.PI / 180, r = 62;
    const x = 100 + r * Math.cos(a), y = 100 + r * Math.sin(a);
    const deg = 200 + i * 18 + 90;
    return `<ellipse cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" rx="5" ry="11" transform="rotate(${deg} ${x.toFixed(1)} ${y.toFixed(1)})"/>` +
           `<ellipse cx="${(200 - x).toFixed(1)}" cy="${y.toFixed(1)}" rx="5" ry="11" transform="rotate(${-deg} ${(200 - x).toFixed(1)} ${y.toFixed(1)})"/>`;
  }).join("");
  return `<svg viewBox="0 0 200 200" class="w-40 md:w-48 h-auto drop-shadow-xl" role="img" aria-label="Award winner ${year}">` +
    `<defs><linearGradient id="hpGold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f6d77a"/><stop offset=".5" stop-color="#d4a017"/><stop offset="1" stop-color="#a87708"/></linearGradient></defs>` +
    `<circle cx="100" cy="100" r="92" fill="#1f2937"/><circle cx="100" cy="100" r="84" fill="none" stroke="url(#hpGold)" stroke-width="3"/>` +
    `<g fill="url(#hpGold)">${leaves}</g>` +
    `<text x="100" y="92" text-anchor="middle" font-family="inherit" font-weight="900" font-size="15" letter-spacing="3" fill="#f6d77a">AWARD</text>` +
    `<text x="100" y="118" text-anchor="middle" font-family="inherit" font-weight="900" font-size="26" fill="#ffffff">${year || "WINNER"}</text>` +
    `<text x="100" y="138" text-anchor="middle" font-family="inherit" font-weight="800" font-size="11" letter-spacing="3" fill="#f6d77a">WINNER</text></svg>`;
}

const show = Boolean(city && name) && (hasRating || reviews.length > 0 || Boolean(award));
const short = str(brand.shortName);
// the full name if short enough, else the short name, else "us"; the inline
// script under the headline shrinks it until it sits on two lines at most
// (character counts can't predict wrapping: "Why Federal Way homeowners
// choose NARESTCO" is 42 characters and still ran three lines on a phone)
const fits = (n: string) => n.length <= 24;
const headName = fits(name) ? name : short && fits(short) ? short : "us";
// Awards as seals (Santino 2026-10-12, Desert Valley): proof belongs here.
// The featured award already shows as the big badge beside the heading, so
// the seals list the client's OTHER awards (no duplicate card).
const awardList = awards().filter((a) => !award || a.name !== award.name).slice(0, 3);
---

{show && (
  <section class="bg-dark-50 py-14 border-y border-dark/10 text-dark-900" aria-labelledby="home-proof-heading">
    <div class="container-wide">
      <div class={award ? "max-w-5xl mx-auto grid gap-8 md:grid-cols-[220px_1fr] items-center text-center md:text-left" : "max-w-4xl mx-auto text-center"}>
        {award && (
          <figure class="m-0 flex flex-col items-center gap-2">
            {award.image
              ? <img src={award.image} alt={`${awardLabel} badge`} class="w-40 md:w-48 h-auto rounded-full shadow-xl" loading="lazy" decoding="async" />
              : <Fragment set:html={medallion(awardYear)} />}
            <figcaption class="text-dark-500 text-[11px] font-bold uppercase tracking-widest text-center max-w-[14rem]">{awardLabel}</figcaption>
            {award.url && <a href={award.url} target="_blank" rel="noopener" class="text-xs font-bold">View the award</a>}
          </figure>
        )}
        <div>
        <div class="eyebrow">Proof, not promises</div>
        <h2 id="home-proof-heading" class="text-base min-[360px]:text-lg sm:text-2xl md:text-3xl text-balance font-black uppercase tracking-tight text-dark-900 mb-4">
          Why {market} homeowners choose {headName}
        </h2>
        <script is:inline>
          (() => {
            const h = document.getElementById("home-proof-heading");
            if (!h) return;
            const fit = () => {
              h.style.fontSize = ""; h.style.lineHeight = "";
              let fs = parseFloat(getComputedStyle(h).fontSize);
              h.style.lineHeight = "1.15";
              for (let i = 0; i < 24 && fs > 14 && h.getBoundingClientRect().height > fs * 1.15 * 2.3; i++) {
                fs -= 1; h.style.fontSize = fs + "px";
              }
            };
            fit();
            addEventListener("resize", fit);
            addEventListener("load", fit);
            // the web font can swap in after the first pass and re-wrap the line
            if (document.fonts) {
              document.fonts.ready.then(fit);
              document.fonts.addEventListener("loadingdone", fit);
            }
          })();
        </script>
        <p class="text-base md:text-lg text-dark-700 m-0">{leadFull}</p>
        {stars > 0 && (
          <div class={`flex justify-center ${award ? "md:justify-start" : ""} gap-1 text-amber-500 mt-3`} aria-hidden="true">
            {Array.from({ length: stars }).map(() => <Star size={22} class="fill-current" />)}
          </div>
        )}
        {awardList.length > 0 && (
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            {awardList.map((a) => {
              const seal = awardSeal(a);
              const Tag = a.url ? "a" : "div";
              return (
                <Tag href={a.url || undefined} target={a.url ? "_blank" : undefined} rel={a.url ? "noopener" : undefined}
                  class="flex items-center gap-3 rounded-2xl border border-amber-300/70 bg-white px-4 py-3 text-left shadow-sm no-underline">
                  <span class="w-11 h-11 rounded-full bg-gradient-to-b from-amber-300 to-amber-500 text-white flex items-center justify-center shrink-0 ring-4 ring-amber-100" aria-hidden="true">
                    <Award size={22} strokeWidth={2.5} />
                  </span>
                  <span class="flex flex-col leading-tight">
                    <span class="font-black text-dark-900">{seal.title}</span>
                    {seal.sub && <span class="text-xs font-semibold text-dark-500">{seal.sub}</span>}
                  </span>
                </Tag>
              );
            })}
          </div>
        )}
        </div>
      </div>

      {reviews.length > 0 && (
        <div class="grid gap-6 md:grid-cols-3 max-w-6xl mx-auto mt-8">
          {reviews.map((r) => (
            <figure class="m-0 p-6 rounded-lg border border-dark/10 bg-white flex flex-col gap-3">
              <div class="flex gap-1 text-amber-500" role="img" aria-label={`${r.rating} out of 5 stars`}>
                {Array.from({ length: Math.min(5, r.rating) }).map(() => <Star size={14} class="fill-current" />)}
              </div>
              <blockquote class="m-0 p-0 border-0 text-dark-700 text-sm leading-relaxed">“{r.quote}”</blockquote>
              <figcaption class="text-dark-500 text-xs font-bold uppercase tracking-widest mt-auto">
                {r.author}, Google review{r.when ? ` · ${r.when}` : ""}
              </figcaption>
            </figure>
          ))}
        </div>
      )}

      <div class="text-center mt-10">
        <a href={`tel:${brand.phoneRaw}`}
           class="inline-flex items-center justify-center gap-2 font-bold px-8 py-3 rounded-md transition-all text-lg shadow-lg bg-cta text-cta-fg hover:bg-cta-hover no-underline">
          <Phone size={20} /> Call {brand.phone}
        </a>
      </div>
    </div>
  </section>
)}
